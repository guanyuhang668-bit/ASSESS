# --- App ---
APP_NAME=UML Grader
APP_ENV=development
DEBUG=true
AUTO_CREATE_TABLES=true                      # 开发期免 alembic，启动时自动建表
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- DB ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=uml_grader
POSTGRES_PASSWORD=uml_grader
POSTGRES_DB=uml_grader

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uml-grader
MINIO_SECURE=false

# --- Auth ---
JWT_SECRET=please-generate-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- LLM API keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
GEMINI_API_KEY=
QWEN3_API_KEY=                                # qwen_3_max 用（DashScope 兼容模式）
